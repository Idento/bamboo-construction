---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  current: string;
}

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.jpg`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171717" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <svg class="pattern pattern-top" viewBox="0 0 536 1120" preserveAspectRatio="xMaxYMin slice" aria-hidden="true">
      <polygon points="0,179.5 574.5,-377 547.5,1119.5"></polygon>
    </svg>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer current={current} />
  </body>
</html>

<style>
  .pattern-top {
    display: none;
    top: 0;
    right: 0;
    width: 536px;
    height: 1120px;
  }

  @media (min-width: 1200px) {
    .pattern-top {
      display: block;
    }
  }
</style>
