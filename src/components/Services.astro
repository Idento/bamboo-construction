---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data/site';

interface Props {
  count?: number;
  headingLevel?: 'h2' | 'h3';
}

const { count = 3, headingLevel: Heading = 'h2' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="services-grid">
  {
    services.slice(0, count).map((service) => (
      <li class="service">
        <div class="service-icon">
          <span class="service-bubble service-bubble--a" />
          <span class="service-bubble service-bubble--b" />
          {typeof service.icon === 'string' ? (
            <Icon name={service.icon} class="service-glyph" />
          ) : (
            <Image class="service-glyph" src={service.icon} alt="" width={56} height={56} />
          )}
        </div>
        <Heading class="service-title">{service.title}</Heading>
        <p class="lead">{service.text}</p>
        <a class="text-link" href={`${base}/services/`}>
          View details<span class="visually-hidden">: {service.title}</span>
          <Icon name="arrow" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .services-grid {
    display: grid;
    gap: 56px 20px;
  }

  .service-icon {
    position: relative;
    width: 56px;
    height: 56px;
  }

  .service-bubble {
    position: absolute;
    width: 23px;
    height: 23px;
    border-radius: 50%;
    background: var(--line);
  }

  .service-bubble--a {
    left: -6px;
    top: 0;
  }

  .service-bubble--b {
    left: 42px;
    top: 35px;
  }

  .service-icon :global(.service-glyph) {
    position: relative;
    width: 56px;
    height: 56px;
  }

  .service-title {
    margin-top: 37px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .service .lead {
    max-width: 420px;
    margin-top: 10px;
  }

  .service .text-link {
    display: flex;
    width: fit-content;
    margin-top: 25px;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 80px;
    }
  }
</style>
