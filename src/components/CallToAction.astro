---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import background from '../assets/images/cta-bg.jpg';

const base = import.meta.env.BASE_URL;
---

<section class="section cta" aria-labelledby="cta-title">
  <Image class="cta-bg" src={background} alt="" widths={[960, 1920]} sizes="100vw" />
  <div class="container cta-inner">
    <h2 class="cta-title" id="cta-title">Are you ready to start your next project?</h2>
    <a class="button button--light" href={`${base}/contact/`}>Get in touch<Icon name="arrow" /></a>
  </div>
</section>

<style>
  .cta {
    isolation: isolate;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  .cta :global(.cta-bg) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 96px;
    text-align: center;
  }

  .cta-title {
    max-width: 751px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 1.4rem + 3vw, 4.3125rem);
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .cta .button {
    margin-top: 46px;
  }

  @media (min-width: 1280px) {
    .cta {
      height: 604px;
    }

    .cta-inner {
      padding-block: 154px 0;
    }
  }
</style>
