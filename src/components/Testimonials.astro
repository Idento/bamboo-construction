---
import { Image } from 'astro:assets';
import background from '../assets/images/testimonial-bg.jpg';
import { testimonials } from '../data/site';
---

<section class="section testimonials" aria-labelledby="testimonials-title" data-slider>
  <Image class="testimonials-bg" src={background} alt="" widths={[960, 1920]} sizes="100vw" />
  <div class="container testimonials-inner">
    <h2 class="visually-hidden" id="testimonials-title">What our clients say</h2>
    <span class="quote-mark" aria-hidden="true">“</span>
    <div class="slides" aria-live="polite">
      {
        testimonials.map((item, index) => (
          <figure class="slide" hidden={index !== 0}>
            <blockquote>
              <p>{item.quote}</p>
            </blockquote>
            <figcaption>
              <strong>{item.name}</strong>
              <span aria-hidden="true">|</span>
              <span>{item.company}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div class="slider-dots">
      {
        testimonials.map((item, index) => (
          <button
            type="button"
            class="slider-dot"
            aria-label={`Show testimonial ${index + 1}: ${item.name}`}
            aria-current={index === 0 ? 'true' : 'false'}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.slider-dot')];
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        slides.forEach((slide, i) => (slide.hidden = i !== index));
        dots.forEach((other, i) => other.setAttribute('aria-current', String(i === index)));
      });
    });
  });
</script>

<style>
  .testimonials {
    isolation: isolate;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  .testimonials :global(.testimonials-bg) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
  }

  .testimonials-inner {
    position: relative;
    padding-block: 96px;
  }

  .quote-mark {
    display: block;
    height: 0.5em;
    font-family: var(--font-display);
    font-size: 120px;
    line-height: 1;
    color: var(--accent);
  }

  .slides {
    display: grid;
  }

  .slide {
    grid-area: 1 / 1;
  }

  .slide[hidden] {
    display: block;
    visibility: hidden;
  }

  blockquote p {
    font-weight: 600;
    font-size: clamp(1.5rem, 0.9rem + 2.2vw, 2.8125rem);
    line-height: 1.7;
    letter-spacing: 0;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    margin-top: 32px;
    font-family: var(--font-display);
    line-height: 1.8;
    letter-spacing: 0;
  }

  figcaption strong {
    font-weight: 600;
  }

  @media (max-width: 599px) {
    figcaption {
      flex-direction: column;
    }

    figcaption [aria-hidden] {
      display: none;
    }
  }

  .slider-dots {
    display: flex;
    gap: 7px;
    margin: 48px 0 0 -8px;
  }

  .slider-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .slider-dot::before {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    margin: auto;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.38);
    transition: background-color 0.2s ease;
  }

  .slider-dot[aria-current='true']::before {
    background: #fff;
  }

  @media (min-width: 900px) {
    .testimonials-inner {
      padding-left: 109px;
    }

    .quote-mark {
      position: absolute;
      left: 0;
      top: 52px;
      height: auto;
      font-size: 194px;
      line-height: 1.2;
    }
  }

  @media (min-width: 1280px) {
    .testimonials {
      height: 883px;
    }

    .testimonials-inner {
      padding-block: 252px 0;
    }

    .quote-mark {
      top: 208px;
    }

    figcaption {
      margin-top: 39px;
    }

    .slider-dots {
      margin-top: 64px;
    }
  }
</style>
