---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
}

const { eyebrow, title, text } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="page-header container" aria-labelledby="page-title">
  <nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
      <li><a href={`${base}/`}>Home</a></li>
      <li aria-current="page">{eyebrow}</li>
    </ol>
  </nav>
  <h1 class="display-1" id="page-title">{title}</h1>
  <p class="lead">{text}</p>
</section>

<style>
  .page-header {
    padding-top: 56px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    line-height: 1.19;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .breadcrumb li + li::before {
    content: '';
    width: 24px;
    height: 2px;
    background: var(--accent);
  }

  .breadcrumb a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .breadcrumb a:hover {
    color: var(--accent-text);
  }

  h1 {
    max-width: 820px;
    margin-top: 24px;
  }

  .lead {
    max-width: 560px;
    margin-top: 20px;
  }

  @media (min-width: 1280px) {
    .page-header {
      padding-top: 145px;
    }
  }
</style>
