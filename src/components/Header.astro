---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Socials from './Socials.astro';
import { navigation } from '../data/site';

interface Props {
  current: string;
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="site-header-inner">
    <Logo />
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      <Icon name="menu" class="menu-icon-open" />
      <Icon name="close" class="menu-icon-close" />
      <span class="visually-hidden">Menu</span>
    </button>
    <div class="site-menu" id="site-menu">
      <nav aria-label="Main">
        <ul class="nav-list">
          {
            navigation.map((item) => (
              <li>
                <a
                  class="nav-link"
                  href={`${base}/${item.href}`}
                  aria-current={item.href === current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <Socials class="header-socials" />
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('site-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    const header = toggle.closest('header');
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    header?.addEventListener('focusout', (event) => {
      if (isOpen() && !header.contains(event.relatedTarget as Node | null)) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (isOpen() && header && !header.contains(event.target as Node)) setOpen(false);
    });

    window.matchMedia('(min-width: 1200px)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--line);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    padding-inline: var(--gutter);
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menu-toggle :global(svg) {
    width: 26px;
    height: 26px;
  }

  .menu-toggle :global(.menu-icon-close),
  .menu-toggle[aria-expanded='true'] :global(.menu-icon-open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.menu-icon-close) {
    display: block;
  }

  .site-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 12px var(--gutter) 32px;
    background: #fff;
    border-bottom: 1px solid var(--line);
    box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.15);
  }

  .site-menu.is-open {
    display: block;
  }

  .nav-link {
    position: relative;
    display: block;
    padding-block: 12px;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.2;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--accent-text);
  }

  .site-menu :global(.header-socials) {
    margin-top: 20px;
  }

  @media (min-width: 1200px) {
    .site-header-inner {
      padding-inline: 50px;
    }

    .menu-toggle {
      display: none;
    }

    .site-menu {
      display: contents;
    }

    nav {
      position: absolute;
      left: 50%;
      top: 0;
      height: calc(100% + 1px);
      transform: translateX(-50%);
    }

    .nav-list {
      display: flex;
      gap: 6px;
      height: 100%;
    }

    .nav-link {
      display: flex;
      align-items: center;
      height: 100%;
      padding: 0 26px;
    }

    .nav-link[aria-current='page']::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 4px;
      background: var(--accent);
    }

    .site-menu :global(.header-socials) {
      margin-top: 0;
    }
  }
</style>
