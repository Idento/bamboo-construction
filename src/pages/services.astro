---
import CallToAction from '../components/CallToAction.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Services from '../components/Services.astro';
import Base from '../layouts/Base.astro';

const steps = [
  { title: 'Site visit', text: 'We meet on site, listen to your needs and measure everything that matters.' },
  { title: 'Design and quote', text: 'You receive drawings, a detailed quote and a realistic schedule.' },
  { title: 'Construction', text: 'One site manager, weekly reports and a clean, safe site every day.' },
  { title: 'Handover', text: 'Final inspection together, documentation and a one-year follow-up.' },
];
---

<Base
  title="Services | Bamboo Construction Co."
  description="New homes, space design, road maintenance, safety audits, heavy structures and renovation."
  current="services/"
>
  <PageHeader
    eyebrow="Services"
    title="Everything you need, from the first sketch to the last brick."
    text="Vehicula at eget a arcu neque, ultricies liquet tempus vel amet eget egestas arcu non."
  />

  <section class="container services-page" aria-label="All services">
    <Services count={6} headingLevel="h2" />
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <SectionTitle eyebrow="How we work" title="Four steps, no surprises" id="process-title" />
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step">
              <span class="step-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  .services-page {
    margin-top: 96px;
  }

  .steps {
    display: grid;
    gap: 20px;
    margin-top: 56px;
  }

  .step {
    padding: 32px;
    border-radius: var(--radius-button);
    background: var(--pattern);
  }

  .step-number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 45px;
    line-height: 1;
    color: var(--accent-text);
  }

  .step h3 {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.5;
  }

  .step p {
    margin-top: 8px;
    color: var(--text);
  }

  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .services-page {
      margin-top: 145px;
    }
  }
</style>
