---
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Page not found | Bamboo Construction Co." description="This page does not exist." current="404">
  <PageHeader eyebrow="404" title="This page is not on our site plan." text="The link may be old or mistyped." />
  <div class="container back">
    <a class="button" href={`${base}/`}>Back to home<Icon name="arrow" /></a>
  </div>
</Base>

<style>
  .back {
    margin-top: 40px;
  }
</style>
